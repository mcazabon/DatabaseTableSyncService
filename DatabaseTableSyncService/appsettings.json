{
  "ConnectionStrings": {
    "SourceDatabase": "Server=SOURCE_SERVER;Database=SOURCE_DATABASE;Integrated Security=true;TrustServerCertificate=false;Encrypt=true;Connection Timeout=30;",
    "TargetDatabase": "Server=TARGET_SERVER;Database=TARGET_DATABASE;Integrated Security=true;TrustServerCertificate=false;Encrypt=true;Connection Timeout=30;"
  },

  "Migration": {
    "CommandTimeoutSeconds": 3600,
    "BatchSize": 100000,
    "MaxRetryAttempts": 3,
    "EnableParallelTables": false,
    "MaximumParallelTables": 2,
    "ValidateAfterMigration": true,

    "Tables": [
      {
        "Schema": "dbo",
        "Name": "Table1",
        "Enabled": true,
        "BatchColumn": "Id"
      },
      {
        "Schema": "dbo",
        "Name": "Table2",
        "Enabled": true,
        "BatchColumn": "Id"
      },
      {
        "Schema": "dbo",
        "Name": "Table3",
        "Enabled": true,
        "BatchColumn": "Id"
      },
      {
        "Schema": "dbo",
        "Name": "Table4",
        "Enabled": true,
        "BatchColumn": "Id"
      },
      {
        "Schema": "dbo",
        "Name": "Table5",
        "Enabled": true,
        "BatchColumn": "Id"
      },
      {
        "Schema": "dbo",
        "Name": "Table6",
        "Enabled": true,
        "BatchColumn": "Id"
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "DatabaseTableSyncService": "Debug",
      "SqlDataMigration": "Debug",
      "Microsoft.Data.SqlClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  }
}
