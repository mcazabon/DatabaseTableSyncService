{
  "ConnectionStrings": {
    "SourceDatabase": "Server=localhost;Database=MigrationTest_Source;Integrated Security=true;TrustServerCertificate=true;",
    "TargetDatabase": "Server=localhost;Database=MigrationTest_Target;Integrated Security=true;TrustServerCertificate=true;"
  },

  "Migration": {
    "CommandTimeoutSeconds": 300,
    "BatchSize": 1000,
    "MaxRetryAttempts": 2,
    "EnableParallelTables": false,
    "MaximumParallelTables": 1,
    "ValidateAfterMigration": true,

    "Tables": [
      {
        "Schema": "dbo",
        "Name": "TestTable",
        "Enabled": true,
        "BatchColumn": "Id"
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
